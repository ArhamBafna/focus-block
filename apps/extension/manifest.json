{
  "manifest_version": 3,
  "name": "Focus Blocker",
  "version": "0.1.0",
  "description": "Block distracting websites, schedule focus time, and use Lockdown directly in Chrome.",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Focus Blocker"
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "nativeMessaging"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "web_accessible_resources": [
    {
      "resources": ["blocked/index.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
