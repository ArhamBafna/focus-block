{
  "manifest_version": 3,
  "name": "Focus Blocker",
  "version": "0.1.0",
  "description": "Block distracting websites and stay in focus. A browser extension mirroring the Focus Blocker desktop app.",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Focus Blocker"
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "alarms"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "declarative_net_request": {
    "rule_resources": []
  },

  "web_accessible_resources": [
    {
      "resources": ["blocked/index.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
